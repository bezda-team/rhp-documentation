{
  "name": "@bezda/rhp",
  "version": "2.0.2",
  "description": "rhp (reactive html plots): plots as stacks of slats, built with SolidJS out of HTML elements and CSS. Built from bezda-team/rhp at fad5ef8 by npm run sync-rhp: don't edit.",
  "license": "MIT",
  "homepage": "https://rhp.vercel.app",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/source/index.js",
      "worker": "./dist/server.js",
      "browser": "./dist/index.js",
      "deno": "./dist/server.js",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./rhp.css": "./dist/rhp.css",
    "./posters.css": "./dist/posters.css"
  },
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "solid-js": "^1.9.0"
  }
}
