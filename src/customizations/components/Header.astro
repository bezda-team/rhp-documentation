---
import type { Props } from '@astrojs/starlight/props';

import {
	LanguageSelect,
	Search,
	SiteTitle,
	SocialIcons,
	ThemeSelect,
} from 'virtual:starlight/components';

// The part of the site this page is in, for the header's links
const path = Astro.url.pathname;
const section = path.startsWith('/gallery') ? 'gallery' : /^\/(start|ai|guides|reference)\//.test(path) ? 'docs' : null;
// The landing page has no sidebar, so on a phone it has no menu to hold the theme control: it gets one of its own.
const landing = path === '/' || path === '/index.html';
---

<div class="header sl-flex">
	<div class="sl-flex">
		<SiteTitle {...Astro.props} />
	</div>
	<div class="sl-flex search-container">
		<Search {...Astro.props} />
	</div>
	<div class="sl-flex right-group">
		<nav class="sl-flex site-links" aria-label="Site">
			<a href="/start/introduction/" aria-current={section === 'docs' ? 'page' : undefined}>Docs</a>
			<a href="/gallery/" aria-current={section === 'gallery' ? 'page' : undefined}>Gallery</a>
		</nav>
		<div class="sl-hidden md:sl-flex social-icons">
			<SocialIcons {...Astro.props} />
		</div>
		{landing && (
			<div class="theme-icon">
				<ThemeSelect {...Astro.props} />
				<button type="button" class="theme-cycle" aria-label="Change the theme"></button>
			</div>
		)}
		<div class="sl-hidden md:sl-flex">
			<ThemeSelect {...Astro.props} />
			<LanguageSelect {...Astro.props} />
		</div>
	</div>
</div>

<style>
	.header {
		justify-content: space-between;
		align-items: center;
		height: 100%;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
	.header :global(.site-title img) {
		padding-left: 4px;
	}
	.site-links {
		gap: 0.25rem;
		align-items: center;
	}
	.site-links a {
		padding: 0.4rem 0.7rem;
		border-radius: 0.5rem;
		color: var(--sl-color-text);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		text-decoration: none;
	}
	.site-links a:hover {
		color: var(--sl-color-white);
		background-color: var(--rhp-color-gray);
	}
	.site-links a[aria-current='page'] {
		color: var(--sl-color-white);
	}
	/* On a phone the landing page's theme control is its icon alone: the select lies over it, so tapping opens the
	   native list, and Starlight swaps the icon to the sun, moon or laptop of the theme in use (ThemeProvider
	   updates every picker on the page, so this one and the one for wider screens stay together). */
	.theme-icon {
		position: relative;
		width: 2.5rem;
		height: 2.5rem;
	}
	/* starlight-theme-select is an inline element between the two, so it has to take a size before the label can fill it */
	.theme-icon :global(starlight-theme-select),
	.theme-icon :global(label) {
		display: flex;
		width: 100%;
		height: 100%;
		justify-content: center;
		align-items: center;
		gap: 0;
	}
	.theme-icon :global(.label-icon) {
		position: static;
		transform: none;
		font-size: 1.75rem;
	}
	.theme-icon :global(.caret) {
		display: none;
	}
	/* Starlight's select stays to hold the choice and to be told about it; the button over the icon is what is tapped */
	.theme-icon :global(select) {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		opacity: 0;
		pointer-events: none;
	}
	.theme-cycle {
		position: absolute;
		inset: 0;
		padding: 0;
		border: 0;
		border-radius: 0.5rem;
		background: none;
		cursor: pointer;
	}

	@media (min-width: 50rem) {
		.theme-icon {
			display: none;
		}
	}

	.social-icons::after {
		content: '';
		height: 2rem;
		border-inline-end: 1px solid var(--sl-color-gray-5);
	}

	@media (min-width: 50rem) {
		:global(:root[data-has-sidebar]) {
			--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
		}
		:global(:root:not([data-has-toc])) {
			--__toc-width: 0rem;
		}
		.header :global(.site-title img) {
			padding-left: 12px;
		}
		.header {
			/* the gap is for wide screens only: a phone gives its width to the title, the search and the links */
			gap: var(--sl-nav-gap);
			--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
			--__main-column-fr: calc(
				(
						100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
							(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
							var(--sl-content-width)
					) / 2
			);
			display: grid;
			grid-template-columns:
        /* 1 (site title): runs up until the main content column’s left edge or the width of the title, whichever is the largest  */
				minmax(
					calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
					auto
				)
				/* 2 (search box): all free space that is available. */
				1fr
				/* 3 (right items): use the space that these need. */
				auto;
			align-content: center;
		}
	}
</style>
<script>
	if(document.body.scrollTop === 0 && document.documentElement.scrollTop === 0) {document.getElementsByTagName("header")[0].classList.add("header-top");}
    
	document.addEventListener("scroll", (event) => {
		if (document.body.scrollTop === 0 && document.documentElement.scrollTop === 0) {document.getElementsByTagName("header")[0].classList.add("header-top");}
		else {document.getElementsByTagName("header")[0].classList.remove("header-top");}
	});

	document.addEventListener("scrollend", (event) => {
		if (document.body.scrollTop === 0 && document.documentElement.scrollTop === 0) {document.getElementsByTagName("header")[0].classList.add("header-top");}
		else {document.getElementsByTagName("header")[0].classList.remove("header-top");}
	});

	// The landing page's theme icon on a phone: each tap takes the next of auto, light and dark. The change goes through
	// Starlight's own select, which stores the choice, sets the page's theme and swaps the icon on every picker.
	const cycle = document.querySelector(".theme-cycle");

	if (cycle) {
		const select = cycle.parentElement.querySelector("select");
		const order = ["auto", "light", "dark"];
		const say = () => cycle.setAttribute("aria-label", `Theme: ${select.value}. Tap for the next one.`);

		say();

		cycle.addEventListener("click", () => {
			select.value = order[(order.indexOf(select.value) + 1) % order.length];
			select.dispatchEvent(new Event("change", { bubbles: true }));
			say();
		});
	}
</script>
