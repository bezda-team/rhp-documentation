---
import { Tabs, TabItem } from '@astrojs/starlight/components';
import AiCopy from './AiCopy.astro';

const server = { command: 'npx', args: ['-y', '@bezda/rhp-mcp'] };
const config = JSON.stringify({ mcpServers: { rhp: server } }, null, 2);
const apps = [
	{
		name: 'Claude Code',
		instruction: 'Run this in your project’s folder to add rhp to that project.',
		code: 'claude mcp add rhp -- npx -y @bezda/rhp-mcp',
	},
	{
		name: 'Codex',
		instruction: 'Run in your terminal, then start a new Codex session.',
		code: 'codex mcp add rhp -- npx -y @bezda/rhp-mcp',
	},
	{
		name: 'Gemini CLI',
		instruction: 'Run in your terminal to add rhp for all your projects.',
		code: 'gemini mcp add --scope user rhp npx -- -y @bezda/rhp-mcp',
	},
	{
		name: 'Copilot CLI',
		instruction: 'Run in your terminal, then start a new Copilot CLI session.',
		code: 'copilot mcp add rhp -- npx -y @bezda/rhp-mcp',
	},
	{
		name: 'Claude Desktop',
		instruction: 'In Settings > Developer > Edit Config, merge this into claude_desktop_config.json, then fully restart Claude.',
		code: config,
	},
	{
		name: 'Cursor',
		instruction: 'Merge this into ~/.cursor/mcp.json for all projects, or .cursor/mcp.json for one project.',
		code: JSON.stringify({ mcpServers: { rhp: { type: 'stdio', ...server } } }, null, 2),
	},
	{
		name: 'VS Code',
		instruction: 'Run in your terminal to add rhp to your VS Code user profile.',
		code: 'code --add-mcp "{\\"name\\":\\"rhp\\",\\"command\\":\\"npx\\",\\"args\\":[\\"-y\\",\\"@bezda/rhp-mcp\\"]}"',
	},
	{
		name: 'Windsurf',
		instruction: 'In Cascade’s MCP panel, choose Open MCP config file and merge this server into the config.',
		code: config,
	},
	{
		name: 'Zed',
		instruction: 'Open the command palette, run “zed: open settings file”, and merge this into your settings.',
		code: JSON.stringify({ context_servers: { rhp: { ...server, env: {} } } }, null, 2),
	},
];
---

<div class="mcp-setup">
	<Tabs>
		{apps.map(({ name, instruction, code }) => (
			<TabItem label={name}>
				<AiCopy text={code} label={`Copy ${name} setup`} />
				<p class="mcp-instruction">{instruction}</p>
			</TabItem>
		))}
	</Tabs>
</div>

<script>
	for (const setup of document.querySelectorAll('.mcp-setup')) {
		const tablist = setup.querySelector<HTMLElement>('[role="tablist"]');
		if (!tablist) continue;
		tablist.setAttribute('aria-label', 'MCP setup by app');
		for (const tab of tablist.querySelectorAll('[role="tab"]')) {
			tab.setAttribute('aria-controls', tab.getAttribute('href')!.slice(1));
		}
	}
</script>

<style>
	.mcp-setup {
		--mcp-code-background: var(--astro-code-color-background);
		--mcp-code-border: var(--sl-color-gray-5);
		--mcp-code-ink: var(--sl-color-white);
		--mcp-tab-accent: var(--sl-color-accent-high);
		min-width: 0;
	}

	:global(:root[data-theme='light']) .mcp-setup {
		--mcp-tab-accent: var(--mcp-code-ink);
	}

	.mcp-setup :global(.tablist-wrapper) {
		padding: 0.5rem 0.6rem 0;
		border: 1px solid var(--mcp-code-border);
		border-radius: var(--page-border-radius-4) var(--page-border-radius-4) 0 0;
		background: var(--mcp-code-background);
		scrollbar-width: thin;
		scrollbar-color: var(--sl-color-gray-4) var(--mcp-code-background);
	}

	.mcp-setup :global([role='tablist']) {
		min-width: max-content;
		margin: 0;
		padding: 0;
		border: 0;
		gap: 2px;
	}

	.mcp-setup :global(.tab) {
		flex: 0 0 auto;
		margin: 0;
	}

	.mcp-setup :global(.tablist-wrapper ~ [role='tabpanel']) {
		margin-top: 0;
	}

	.mcp-setup :global(.tab > [role='tab']) {
		padding: 10px 13px;
		border: 0;
		border-radius: 6px 6px 0 0;
		background: transparent;
		color: var(--sl-color-gray-2);
		font: 500 13px / 1.4 var(--__sl-font-mono);
		text-align: center;
		white-space: nowrap;
	}

	.mcp-setup :global(.tab > [role='tab']:hover) {
		color: var(--mcp-code-ink);
	}

	.mcp-setup :global(.tab > [role='tab'][aria-selected='true']) {
		background: var(--mcp-code-background);
		color: var(--mcp-code-ink);
		font-weight: 500;
		box-shadow: inset 0 -2px 0 var(--mcp-tab-accent);
	}

	.mcp-setup :global([role='tab']:focus-visible),
	.mcp-setup :global(.ai-copy button:focus-visible) {
		outline: 2px solid var(--mcp-code-ink);
		outline-offset: -3px;
	}

	.mcp-setup :global(.ai-copy) {
		align-items: flex-start;
		padding: 1rem;
		border: 1px solid var(--mcp-code-border);
		border-top: 0;
		border-radius: 0 0 var(--page-border-radius-4) var(--page-border-radius-4);
		background: var(--mcp-code-background);
		box-shadow: none;
	}

	.mcp-setup :global(.ai-copy pre) {
		color: var(--mcp-code-ink);
	}

	.mcp-setup :global(.ai-copy button) {
		min-width: 0;
		border-color: var(--sl-color-gray-4);
		border-radius: 6px;
		background: transparent;
		color: var(--mcp-code-ink);
		font-size: 13px;
	}

	.mcp-setup :global(.ai-copy button:hover) {
		border-color: var(--sl-color-gray-2);
		background: var(--rhp-color-gray);
		color: var(--mcp-code-ink);
	}

	.mcp-setup :global(.ai-copy button[data-copied]) {
		border-color: var(--mcp-tab-accent);
	}

	.mcp-instruction {
		margin: 0.9rem 0 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-text);
	}
</style>
