---
import { getImage } from "astro:assets";
import { realPosters } from "../../../gallery/real-posters.js";
import "../../styles/gallery.css";

const shots = import.meta.glob<{ default: ImageMetadata }>("../../../assets/real-posters/*.png", { eager: true });
const tiles = await Promise.all(realPosters().map(async (poster, index) => {
	const image = shots[`../../../assets/real-posters/${poster.slug}.png`]?.default;
	if (!image) throw new Error(`Missing real poster thumbnail for ${poster.slug}. Run npm run sync-real-posters.`);
	const widths = [360, 720, 1080].filter((width) => width <= image.width);
	const variants = await Promise.all(widths.map((width) => getImage({ src: image, width, format: "webp" })));
	return { ...poster, index, image, src: variants.at(-1)!.src, srcset: variants.map((variant, i) => `${variant.src} ${widths[i]}w`).join(", ") };
}));
const sizes = "(min-width: 1180px) 527px, 44vw";
---

<section class="real-poster-gallery not-content" aria-labelledby="real-posters">
	<h2 id="real-posters">Real posters</h2>
	<p class="real-poster-lede">Finished posters built with rhp from real, sourced data. Open one to explore the chart or download the full poster.</p>
	<ul class="real-poster-tiles">
		{tiles.map((poster) => (
			<li class="gallery-tile">
				<a href={poster.url}>
					<picture class="gallery-shot">
						<img src={poster.src} srcset={poster.srcset} sizes={sizes} width={poster.image.width} height={poster.image.height}
							alt={`${poster.title}: ${poster.description}`} loading="lazy" decoding="async" />
					</picture>
					<span class="gallery-meta">
						<span class="gallery-num" aria-hidden="true">{String(poster.index + 1).padStart(2, "0")}</span>
						<span class="gallery-title">{poster.title}</span>
						<span class="gallery-poster">{poster.description}</span>
					</span>
				</a>
			</li>
		))}
	</ul>
</section>

<style>
	.real-poster-gallery.not-content { margin-top: 5rem; }
	h2 { margin: 0; scroll-margin-top: calc(var(--sl-nav-height) + 1.5rem); font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; font-weight: 600; letter-spacing: -.03em; color: var(--sl-color-white); }
	.real-poster-lede { max-width: 60ch; margin: 1rem 0 2rem; font-size: var(--sl-text-lg); line-height: 1.55; color: var(--sl-color-text); }
	.real-poster-tiles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 26px; align-items: start; margin: 0; padding: 0; list-style: none; }
	@media (max-width: 40rem) {
		.real-poster-tiles { gap: 24px 14px; }
		.gallery-meta { grid-template-columns: minmax(0, 1fr); padding-inline: 0; gap: 3px; }
		.gallery-num { grid-row: auto; font-size: 11px; }
		.gallery-title { font-size: 16px; }
		.gallery-poster { font-size: 12px; line-height: 1.45; }
	}
</style>
